{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Focus Pot",
  "version": "1.1.1",
  "identifier": "com.focuspot.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Focus Pot",
        "url": "index.html",
        "width": 540,
        "height": 680,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "Shivansh Sharma",
    "copyright": "© 2026 Shivansh Sharma. MIT License.",
    "license": "MIT",
    "homepage": "https://github.com/Shivanshxsharma/focus-pot",
    "category": "Productivity",
    "shortDescription": "Focus Pot: Pomodoro, tasks, music, clipboard and screenshots on your Windows taskbar",
    "longDescription": "A small, premium companion on the left end of the Windows 11 taskbar: a Pomodoro timer, a task list, controls for every media app, a clipboard history, quick links and a screenshot organizer, in a Windows, Material or macOS Liquid Glass look.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "startMenuFolder": "Focus Pot"
      }
    }
  }
}
